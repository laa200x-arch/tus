{
  "name": "tus-win",
  "version": "1.0.0",
  "description": "职场那些事 - 按同事属性/公司属性/主题/软件四维记录职场观察的 Windows 桌面版（与 iOS 端共用服务器）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win nsis"
  },
  "author": "tus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "socket.io-client": "^4.7.5"
  },
  "build": {
    "appId": "com.tus.tucao",
    "productName": "职场那些事",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
